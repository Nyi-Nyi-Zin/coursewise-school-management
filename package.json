{
  "name": "school-course-management",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter admin-dashboard exec next dev",
    "build": "pnpm run admin:build",
    "check": "tsc --noEmit && pnpm admin:typecheck && pnpm student:typecheck",
    "admin:typecheck": "pnpm --filter admin-dashboard run typecheck",
    "student:typecheck": "pnpm --filter student-website run typecheck",
    "format": "prettier --write .",
    "test": "vitest run && vitest run --config student-website/vitest.config.ts && vitest run --config admin-dashboard/vitest.config.ts",
    "migrate:lesson-progress": "node --env-file=.env scripts/migrate-lesson-progress.mjs",
    "admin:dev": "pnpm --filter admin-dashboard exec next dev",
    "admin:build": "pnpm --filter admin-dashboard run build",
    "admin:lint": "pnpm --filter admin-dashboard run lint",
    "student:web:dev": "pnpm --filter student-website exec next dev",
    "student:web:build": "pnpm --filter student-website run build",
    "audit:deps": "pnpm audit --audit-level high",
    "audit:secrets": "node scripts/check-secret-hygiene.mjs",
    "test:rules": "vitest run firebase/firestore.rules.test.ts --no-file-parallelism",
    "audit:rules": "firebase emulators:exec --project demo-coursewise-audit --only firestore \"pnpm test:rules\"",
    "test:e2e": "playwright test",
    "audit:lighthouse": "node scripts/run-lighthouse-audit.mjs",
    "quality:gate": "pnpm audit:secrets && pnpm audit:deps && pnpm admin:lint && pnpm --filter student-website run lint && pnpm test && pnpm audit:rules && pnpm admin:build && pnpm student:web:build && pnpm test:e2e && pnpm audit:lighthouse"
  },
