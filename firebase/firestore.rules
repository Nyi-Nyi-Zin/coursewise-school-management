rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && userDoc().data.role == 'admin'; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isActiveStudent() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc().data.role == 'student' && userDoc().data.get('isActive', true) != false &&
        request.auth.token.email_verified == true;
    }
    function isPublished() { return resource.data.isPublished == true; }
    function hasBatchFields(data) { return data.courseId is string && data.batchId is string; }
    function isBatchMember(courseId, batchId) {
      return isActiveStudent() && exists(/databases/$(database)/documents/enrollments/$(courseId + '_' + batchId + '_' + request.auth.uid));
    }
    function isActiveBatchMember(courseId, batchId) {
      return isBatchMember(courseId, batchId) && get(/databases/$(database)/documents/enrollments/$(courseId + '_' + batchId + '_' + request.auth.uid)).data.status == 'active';
    }
    function canReadBatchContent() {
      return hasBatchFields(resource.data) && isActiveBatchMember(resource.data.courseId, resource.data.batchId);
    }
    function hasQuizBatchScope(data) {
      return data.keys().hasAll(['batchId']) && data.batchId is string && data.batchId != '';
    }
    function canReadQuizContent() {
      return resource.data.courseId is string && (hasQuizBatchScope(resource.data) ? canReadBatchContent() : canReadCourseContent());
    }
    function canReadCourseContent() {
      return isActiveStudent() && resource.data.courseId is string &&
        get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.enrolledStudentIds.hasAny([request.auth.uid]);
    }
    function canReadOwnBatchRecord() {
      return signedIn() && resource.data.studentId == request.auth.uid && hasBatchFields(resource.data) && isActiveBatchMember(resource.data.courseId, resource.data.batchId);
    }
    function assignmentIsReadable(assignmentId, courseId, batchId) {
      let assignment = get(/databases/$(database)/documents/assignments/$(assignmentId));
      return assignment.data.isPublished == true && assignment.data.courseId == courseId &&
        assignment.data.batchId == batchId && isActiveBatchMember(courseId, batchId);
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.auth.token.email_verified == true &&
        request.resource.data.role == 'student' &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.keys().hasOnly(['name', 'email', 'role', 'studentId', 'createdAt', 'updatedAt'])
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) &&
        isActiveStudent() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoUrl', 'phone', 'updatedAt']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoUrl']) || (
          resource.data.get('photoUrl', null) in [null, ''] &&
          request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() > 0
        ))
      );
    }

    match /courses/{courseId} {
      // Course documents maintain enrolledStudentIds solely for safe course-list discovery.
      allow read: if isAdmin() || (isActiveStudent() && resource.data.enrolledStudentIds.hasAny([request.auth.uid]));
      allow create, update, delete: if isAdmin();

    }

    // Each batch belongs to one course through its courseId field.
    match /batches/{batchId} {
      allow read: if isAdmin() || (isActiveStudent() && resource.data.enrolledStudentIds.hasAny([request.auth.uid]));
      allow create, update, delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (isOwner(resource.data.studentId) && isBatchMember(resource.data.courseId, resource.data.batchId));
      // Deletes have no request.resource, so field validation only applies to writes.
      allow create, update: if isAdmin() &&
        request.resource.data.studentId is string &&
        request.resource.data.courseId is string &&
        request.resource.data.batchId is string;
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || (isPublished() && canReadBatchContent());
      allow create, update, delete: if isAdmin();
    }

    // Legacy profile records managed by the admin workspace; live accounts live under /users.
    match /students/{recordId} {
      allow read, write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAdmin() || (isPublished() && canReadBatchContent());
      allow create, update, delete: if isAdmin();
    }

    // Per-student, per-course-batch lesson progress.
    match /lessonProgress/{progressId} {
      allow read: if isAdmin() || canReadOwnBatchRecord();
      allow create: if isAdmin() || (
        isActiveStudent() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.lessonId is string &&
        hasBatchFields(request.resource.data) &&
        request.resource.data.status in ['new', 'continue', 'complete'] &&
        isActiveBatchMember(request.resource.data.courseId, request.resource.data.batchId) &&
        get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data.isPublished == true &&
        get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data.courseId == request.resource.data.courseId &&
        get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data.batchId == request.resource.data.batchId
      );
      allow update: if isAdmin() || (
        canReadOwnBatchRecord() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status in ['new', 'continue', 'complete'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }
    match /quizzes/{quizId} {
      allow read: if isAdmin() || (isPublished() && canReadQuizContent());
      allow create, update, delete: if isAdmin();

      // Question documents contain display text, options, marks, and sort order only.
      match /questions/{questionId} {
        // Students receive only the server-selected session questions. Direct
        // collection access would expose the complete final-exam question bank.
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // Correct answers never reach student clients; only admin clients and server Admin SDK calls can access them.
      match /answerKeys/{questionId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /quizAttempts/{attemptId} {
      allow read: if isAdmin() || canReadOwnBatchRecord();
      // Authenticated backend routes calculate scores and persist attempts with the Admin SDK.
      allow create, update, delete: if isAdmin();
    }

    // Trusted per-student roll-ups written only by the grading backend.
    match /quizSummaries/{summaryId} {
      allow read: if isAdmin() || (isActiveStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Attempt counters guard retake limits; clients may never read or write them.
    match /quizAttemptCounters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Trusted assessment state and immutable chapter-review snapshots are
    // written/read through authenticated server routes only.
    match /assessmentSessions/{sessionId} { allow read, write: if isAdmin(); }
    match /quizAttemptReviews/{reviewId} { allow read, write: if isAdmin(); }
    match /enrollmentLocks/{studentId} { allow read, write: if isAdmin(); }

    match /certificates/{certificateId} {
      allow read: if isAdmin() || (isActiveStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || canReadOwnBatchRecord();
      allow create, update, delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin() || (isPublished() && canReadBatchContent());
      allow create, update, delete: if isAdmin();
    }

    match /assignmentSubmissions/{submissionId} {
      allow read: if isAdmin() || canReadOwnBatchRecord();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid &&
        isActiveStudent() &&
        request.resource.data.keys().hasOnly(['assignmentId', 'studentId', 'courseId', 'batchId', 'submissionText', 'submissionUrl', 'submissionFileName', 'submittedAt', 'updatedAt']) &&
        hasBatchFields(request.resource.data) && request.resource.data.assignmentId is string &&
        assignmentIsReadable(request.resource.data.assignmentId, request.resource.data.courseId, request.resource.data.batchId) &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (request.resource.data.get('submissionText', null) == null || (request.resource.data.submissionText is string && request.resource.data.submissionText.size() <= 10000)) &&
        (request.resource.data.get('submissionUrl', null) == null || (request.resource.data.submissionUrl is string && request.resource.data.submissionUrl.size() <= 2048)) &&
        (request.resource.data.get('submissionFileName', null) == null || (request.resource.data.submissionFileName is string && request.resource.data.submissionFileName.size() <= 255));
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isActiveStudent() && resource.data.studentId == request.auth.uid &&
        resource.data.get('score', null) == null && resource.data.get('feedback', null) == null);
    }
  }
}
