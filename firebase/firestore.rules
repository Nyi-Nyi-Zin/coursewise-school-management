rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && userDoc().data.role == 'admin'; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isPublished() { return resource.data.isPublished == true; }
    function hasBatchFields(data) { return data.courseId is string && data.batchId is string; }
    function isBatchMember(courseId, batchId) {
      return signedIn() && exists(/databases/$(database)/documents/courses/$(courseId)/batches/$(batchId)/enrollments/$(request.auth.uid));
    }
    function isActiveBatchMember(courseId, batchId) {
      return isBatchMember(courseId, batchId) && get(/databases/$(database)/documents/courses/$(courseId)/batches/$(batchId)/enrollments/$(request.auth.uid)).data.status == 'active';
    }
    function canReadBatchContent() {
      return hasBatchFields(resource.data) && isActiveBatchMember(resource.data.courseId, resource.data.batchId);
    }
    function canReadOwnBatchRecord() {
      return signedIn() && resource.data.studentId == request.auth.uid && hasBatchFields(resource.data) && isActiveBatchMember(resource.data.courseId, resource.data.batchId);
    }
    function quizIsReadable(quizId) {
      let quiz = get(/databases/$(database)/documents/quizzes/$(quizId));
      return quiz.data.isPublished == true && isActiveBatchMember(quiz.data.courseId, quiz.data.batchId);
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == 'student' &&
        request.resource.data.keys().hasOnly(['name', 'email', 'role', 'studentId', 'createdAt', 'updatedAt'])
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoUrl', 'phone', 'updatedAt'])
      );
    }

    match /courses/{courseId} {
      // Course documents maintain enrolledStudentIds solely for safe course-list discovery.
      allow read: if isAdmin() || (signedIn() && resource.data.enrolledStudentIds.hasAny([request.auth.uid]));
      allow create, update, delete: if isAdmin();

      match /batches/{batchId} {
        allow read: if isAdmin() || isBatchMember(courseId, batchId);
        allow create, update, delete: if isAdmin();

        match /enrollments/{studentId} {
          allow read: if isAdmin() || (isOwner(studentId) && isBatchMember(courseId, batchId));
          allow create, update, delete: if isAdmin() &&
            request.resource.data.studentId == studentId &&
            request.resource.data.courseId == courseId &&
            request.resource.data.batchId == batchId;
        }
      }
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || (isPublished() && canReadBatchContent());
      allow create, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAdmin() || (isPublished() && canReadBatchContent());
      allow create, update, delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isAdmin() || (isPublished() && canReadBatchContent());
      allow create, update, delete: if isAdmin();

      // Question documents contain display text, options, marks, and sort order only.
      match /questions/{questionId} {
        allow read: if isAdmin() || quizIsReadable(quizId);
        allow create, update, delete: if isAdmin();
      }

      // Correct answers never reach student clients; only admin clients and server Admin SDK calls can access them.
      match /answerKeys/{questionId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /quizAttempts/{attemptId} {
      allow read: if isAdmin() || canReadOwnBatchRecord();
      // Callable functions calculate scores and persist attempts with the Admin SDK.
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || canReadOwnBatchRecord();
      allow create, update, delete: if isAdmin();
    }
  }
}
