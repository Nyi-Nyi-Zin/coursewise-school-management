rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      // Students may create exactly one fixed-name profile photo. Admins can
      // replace or remove it from the administrator portal.
      allow create: if (isAdmin() || (signedIn() && request.auth.uid == userId && fileName == 'profile.jpg'))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }
    match /banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /assignments/{studentId}/{fileName} {
      allow read: if true;
      // Students store their assignment submission files under their own uid.
      allow create: if (signedIn() && request.auth.uid == studentId)
        && request.resource.size < 20 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }
    match /lessons/{fileName} {
      allow read: if true;
      // Lesson documents and large media (PDFs, videos) are administrator-managed.
      allow create, update: if isAdmin()
        && request.resource.size < 100 * 1024 * 1024;
      allow delete: if isAdmin();
    }
  }
}
